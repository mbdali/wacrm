# Settings for docker-compose.stack.yml. Copy to .env.stack.
# Loaded after ../supabase/docker/.env, so values here override it.
# Supabase secrets (JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY,
# POSTGRES_PASSWORD, ...) live in ../supabase/docker/.env.

############
# Public address — what the browser opens. Baked into the app at build
# time, so changing it needs `sh stack.sh up -d --build`.
#
# Local:       PUBLIC_HOST=raqmichats.localhost  HTTP_PORT=8080
#              PUBLIC_URL=http://raqmichats.localhost:8080
# Production:  PUBLIC_HOST=raqmichats.com  HTTP_PORT=80
#              PUBLIC_URL=https://raqmichats.com   (Caddy gets the cert)
############
PUBLIC_HOST=raqmichats.localhost
HTTP_PORT=8080
HTTPS_PORT=443
PUBLIC_URL=http://raqmichats.localhost:8080

############
# Point Supabase at the public address.
############
SUPABASE_PUBLIC_URL=${PUBLIC_URL}
API_EXTERNAL_URL=${PUBLIC_URL}/auth/v1
SITE_URL=${PUBLIC_URL}
ADDITIONAL_REDIRECT_URLS=${PUBLIC_URL}/**
SMTP_SENDER_NAME=RaqmiChats

# Postgres published on 127.0.0.1 of the host (psql, backups).
DB_HOST_PORT=5432

############
# App secrets
############
# 64 hex chars: openssl rand -hex 32. Keep it — it decrypts stored tokens.
ENCRYPTION_KEY=
META_APP_SECRET=
APP_LOCALE=en

############
# Only for a database whose migrations were applied by hand: the last
# migration already applied (e.g. 059). Recorded once, then ignored.
############
MIGRATIONS_BASELINE=
